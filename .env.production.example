# Production environment template.
# The API refuses to start with APP_ENV=production and any of these left at
# their development defaults — see app/config.py:validate_runtime().

APP_ENV=production

# --- Database -----------------------------------------------------------
# Postgres (Supabase / Neon). Note the +asyncpg driver.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
# Or managed MySQL:
# DATABASE_URL=mysql+aiomysql://USER:PASSWORD@HOST:3306/DBNAME

# --- Security -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_48_CHAR_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Seeds the single admin account on first start. Use a real password.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_FULL_NAME=Administrator

# Exact frontend origins, comma separated. No wildcards.
CORS_ORIGINS=https://your-app.vercel.app

# --- AI provider --------------------------------------------------------
# Optional: can also be set from the Settings screen after deploy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Limits & storage ---------------------------------------------------
QUERY_RATE_LIMIT_PER_MINUTE=20
MAX_QUERY_ROWS=200
UPLOAD_DIR=/data/uploads

# Durable CSV/Excel storage (required on ephemeral hosts like Render free).
# Create a private bucket in Supabase → Storage, then paste the service_role
# key from Project Settings → API. Never expose service_role to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=datasets

# Must stay false in production: it logs query data and credentials.
SQL_ECHO=false
# Interactive API docs are disabled in production regardless.
EXPOSE_API_DOCS=false

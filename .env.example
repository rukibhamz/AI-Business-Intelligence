# Database (XAMPP MySQL default)
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/ai_bi

# Security (Phase 3+)
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Admin

# AI Provider (Phase 4+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App
APP_ENV=development
UPLOAD_DIR=uploads

# --- Authentication ---------------------------------------------------------
# Leave these empty to keep local accounts (the ADMIN_EMAIL/ADMIN_PASSWORD pair
# above). Set the first two and sign-in moves to Supabase: accounts, passwords
# and confirmation emails are handled there, and anyone can sign up.
#
#   SUPABASE_URL       Project URL, e.g. https://abcdefgh.supabase.co
#   SUPABASE_ANON_KEY  Publishable anon key. Public by design — the browser
#                      needs it. Never put the service_role key here.
#   SUPABASE_JWT_SECRET
#                      Only for projects still issuing HS256 tokens (Project
#                      Settings > API > JWT Secret). Projects using JWT signing
#                      keys need nothing here: the public keys are fetched from
#                      the project's JWKS endpoint.
#
# The first account to sign in becomes the admin, as does ADMIN_EMAIL. Admin
# unlocks Settings only — every account sees just the datasets it uploaded.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Dataset file storage (recommended on Render / any host without a persistent disk).
# Create a private bucket named "datasets" in Supabase → Storage, then set the
# service_role key (Project Settings → API). Never put service_role in ANON_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=datasets

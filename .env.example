# Database (XAMPP MySQL default)
DATABASE_URL=mysql+aiomysql://root:@localhost:3306/ai_bi

# Security (Phase 3+)
SECRET_KEY=change-me-to-a-random-64-char-string

# AI Provider (Phase 4+)
OPENAI_API_KEY=sk-your-key-here
